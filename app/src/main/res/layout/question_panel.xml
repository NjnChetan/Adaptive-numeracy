<?xml version="1.0" encoding="utf-8"?>
<!-- Outer FrameLayout is the cell boundary — clips rotated content to its bounds -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true">

    <!--
      panelContent is what actually rotates.
      MainActivity rotates this view + applies scaleX/scaleY so it always
      fills the cell regardless of which 90° step it is on.
    -->
    <FrameLayout
        android:id="@+id/panelContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EDEEFF">

        <!-- ══════════════════════════════════════════════════════════════
             HOME SCREEN
        ══════════════════════════════════════════════════════════════════ -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/homeLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- ── Language toggle: EN ── switch ── MR (top-right) ───────── -->

            <TextView
                android:id="@+id/labelEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#2B3A8C"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/langToggle" />

            <!--
              FIX 1: removed android:text="@string/start" — caused the toggle to
                     display "Start" text (or asterisks if the string was missing).
              FIX 2: added app:showText="false" — suppresses the * / · indicators
                     that SwitchCompat draws inside the thumb on some API levels.
            -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/langToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="2dp"
                android:checked="false"
                app:showText="false"
                app:thumbTint="#FFFFFF"
                app:trackTint="#8A99CC"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/labelMr" />

            <TextView
                android:id="@+id/labelMr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MR"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#2B3A8C"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ── Operation buttons 2×2 ────────────────────────────────── -->

            <!--
              FIX 3: buttons were half-visible because btnMul/btnDiv had
                     constraintTop_toBottomOf="@id/btnAdd/@id/btnSub" which
                     correctly chains rows, BUT btnAdd/btnSub had no bottom
                     constraint — so ConstraintLayout couldn't resolve their
                     height and clipped them.
              Fix:  chain all 4 buttons vertically with proper top+bottom
                    constraints forming a packed chain between langToggle and startBtn.
            -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="+"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_margin="12dp"
                app:backgroundTint="#8A99CC"
                app:cornerRadius="500dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toBottomOf="@id/langToggle"
                app:layout_constraintBottom_toTopOf="@id/btnMul"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnSub" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSub"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="−"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_margin="12dp"
                app:backgroundTint="#8A99CC"
                app:cornerRadius="500dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toBottomOf="@id/langToggle"
                app:layout_constraintBottom_toTopOf="@id/btnDiv"
                app:layout_constraintStart_toEndOf="@id/btnAdd"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMul"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="×"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_margin="12dp"
                app:backgroundTint="#8A99CC"
                app:cornerRadius="500dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toBottomOf="@id/btnAdd"
                app:layout_constraintBottom_toTopOf="@id/startBtn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnDiv" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiv"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="÷"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_margin="12dp"
                app:backgroundTint="#8A99CC"
                app:cornerRadius="500dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toBottomOf="@id/btnSub"
                app:layout_constraintBottom_toTopOf="@id/startBtn"
                app:layout_constraintStart_toEndOf="@id/btnMul"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ── Start button ─────────────────────────────────────────── -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start"
                android:textColor="#FFFFFF"
                android:enabled="false"
                app:backgroundTint="#8A99CC"
                app:cornerRadius="50dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="20dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ══════════════════════════════════════════════════════════════
             QUIZ SCREEN
        ══════════════════════════════════════════════════════════════════ -->

        <LinearLayout
            android:id="@+id/quizLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Quiz content -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Score badge -->

                <TextView
                    android:id="@+id/scoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/0"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:padding="6dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_score_badge"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Question card -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/questionCard"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="10dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/scoreText"
                    app:layout_constraintBottom_toTopOf="@id/btnRow1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:id="@+id/cardBorder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/question_card_border"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/questionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:textColor="#1A1A2E" />

                        <TextView
                            android:id="@+id/feedbackText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:visibility="gone" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Answer buttons row 1 -->

                <LinearLayout
                    android:id="@+id/btnRow1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_margin="10dp"
                    app:layout_constraintBottom_toTopOf="@id/btnRow2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/option1"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#2B3A8C"
                        app:cornerRadius="50dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/option2"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#2B3A8C"
                        app:cornerRadius="50dp" />

                </LinearLayout>

                <!-- Answer buttons row 2 -->

                <LinearLayout
                    android:id="@+id/btnRow2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_margin="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/option3"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#2B3A8C"
                        app:cornerRadius="50dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/option4"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#2B3A8C"
                        app:cornerRadius="50dp" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Bottom nav bar -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="vertical"
                android:background="#F0F0FF">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#C8C8E0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/navHome"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="⌂"
                        android:textSize="20sp"
                        android:textColor="#2B3A8C"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/navRotate"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="⟳"
                        android:textSize="20sp"
                        android:textColor="#2B3A8C"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout><!-- end panelContent -->

</FrameLayout><!-- end outer clip container -->