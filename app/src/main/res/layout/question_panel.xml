<?xml version="1.0" encoding="utf-8"?>
<!--
  res/layout/question_panel.xml

  homeLayout:
    • Top-right: EN | toggle | MR  language switch
    • Title "Training Panel" (localised)
    • 2×2 grid of large operation symbol buttons: + − × ÷
      Selected button highlights in dark navy; others stay light
    • Start button (enabled only after an operation is chosen)

  quizLayout: unchanged — score badge + question card + 2×2 answer buttons + nav bar
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDEEFF">

    <!-- ══════════════════════════════════════════════════════════════
         HOME / SETUP SCREEN
    ══════════════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/homeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- ── Language toggle row (top-right) ─────────────────────── -->
        <!-- "EN" label -->
        <TextView
            android:id="@+id/labelEn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EN"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#2B3A8C"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/langToggle" />

        <!-- Toggle switch — SwitchCompat avoids deprecated android.widget.Switch -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/langToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:checked="false"
            app:thumbTint="#FFFFFF"
            app:trackTint="#8A99CC"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/labelMr" />

        <!-- "MR" label -->
        <TextView
            android:id="@+id/labelMr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MR"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#2B3A8C"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Operation buttons 2×2 grid — anchored below lang toggle ── -->

        <!-- Row 1 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="16dp"
            android:text="+"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#8A99CC"
            app:cornerRadius="500dp"
            app:layout_constraintTop_toBottomOf="@id/labelEn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSub"
            app:layout_constraintBottom_toTopOf="@id/btnMul"
            app:layout_constraintDimensionRatio="1:1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSub"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:text="−"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#8A99CC"
            app:cornerRadius="500dp"
            app:layout_constraintTop_toBottomOf="@id/labelEn"
            app:layout_constraintStart_toEndOf="@id/btnAdd"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/btnDiv"
            app:layout_constraintDimensionRatio="1:1" />

        <!-- Row 2 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMul"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="12dp"
            android:text="×"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#8A99CC"
            app:cornerRadius="500dp"
            app:layout_constraintTop_toBottomOf="@id/btnAdd"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnDiv"
            app:layout_constraintBottom_toTopOf="@id/startBtn"
            app:layout_constraintDimensionRatio="1:1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiv"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:text="÷"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#8A99CC"
            app:cornerRadius="500dp"
            app:layout_constraintTop_toBottomOf="@id/btnSub"
            app:layout_constraintStart_toEndOf="@id/btnMul"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/startBtn"
            app:layout_constraintDimensionRatio="1:1" />

        <!-- ── Start button ─────────────────────────────────────────── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/startBtn"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Start"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:enabled="false"
            app:backgroundTint="#8A99CC"
            app:cornerRadius="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════════════════════════════════════════
         QUIZ SCREEN
    ══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/quizLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Main content: score badge + question card + answer buttons -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#EDEEFF">

            <!-- Score badge: navy, top-left -->
            <TextView
                android:id="@+id/scoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_margin="8dp"
                android:background="#1A2560"
                android:backgroundTint="#1A2560"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- White question card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/questionCard"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/scoreText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/btnRow1">

                <TextView
                    android:id="@+id/questionText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="26sp"
                    android:textColor="#1A1A2E"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.2"
                    android:text=" 282&#10;+204" />

            </androidx.cardview.widget.CardView>

            <!-- Answer buttons row 1 -->
            <LinearLayout
                android:id="@+id/btnRow1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="5dp"
                app:layout_constraintBottom_toTopOf="@id/btnRow2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/option1"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="—"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#2B3A8C"
                    app:cornerRadius="50dp"
                    app:rippleColor="#1E2D6B" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/option2"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="—"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#2B3A8C"
                    app:cornerRadius="50dp"
                    app:rippleColor="#1E2D6B" />

            </LinearLayout>

            <!-- Answer buttons row 2 -->
            <LinearLayout
                android:id="@+id/btnRow2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/option3"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="—"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#2B3A8C"
                    app:cornerRadius="50dp"
                    app:rippleColor="#1E2D6B" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/option4"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="—"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#2B3A8C"
                    app:cornerRadius="50dp"
                    app:rippleColor="#1E2D6B" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Bottom nav bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="vertical"
            android:background="#F0F0FF">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#C8C8E0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/navHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="⌂"
                    android:textSize="18sp"
                    android:textColor="#2B3A8C"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <TextView
                    android:id="@+id/navSettings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="⚙"
                    android:textSize="17sp"
                    android:textColor="#2B3A8C"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <TextView
                    android:id="@+id/backBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="☰"
                    android:textSize="17sp"
                    android:textColor="#2B3A8C"
                    android:background="?attr/selectableItemBackgroundBorderless" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>