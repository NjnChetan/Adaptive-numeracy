<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true">

    <FrameLayout
        android:id="@+id/panelContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EDEEFF">

        <!-- ══════════════════════════════════════════════════
             HOME SCREEN
        ══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/homeLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Lang toggle row — aligned to end (top-right) -->

            <!-- Middle: op grid + start button, fills remaining space -->
            <LinearLayout
                android:id="@+id/langBar"
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/labelEn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="2dp"
                    android:text="EN"
                    android:textColor="#2B3A8C"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/langToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    app:showText="false"
                    app:thumbTint="#FFFFFF"
                    app:trackTint="#8A99CC" />

                <TextView
                    android:id="@+id/labelMr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:text="MA"
                    android:textColor="#2B3A8C"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeMiddle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 2×2 op grid fills available space -->
                <LinearLayout
                    android:id="@+id/opContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <LinearLayout
                        android:id="@+id/opRow1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAdd"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_margin="4dp"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:backgroundTint="#8A99CC"
                            app:cornerRadius="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSub"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_margin="4dp"
                            android:text="−"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:backgroundTint="#8A99CC"
                            app:cornerRadius="16dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/opRow2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMul"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="×"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:backgroundTint="#8A99CC"
                            app:cornerRadius="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDiv"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="÷"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:backgroundTint="#8A99CC"
                            app:cornerRadius="16dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Start button — centred, pushed down with top margin -->
                <LinearLayout
                    android:id="@+id/startBtnWrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/startBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start"
                        android:textColor="#FFFFFF"
                        android:enabled="false"
                        app:backgroundTint="#8A99CC"
                        app:cornerRadius="50dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Fixed nav bar -->
            <LinearLayout
                android:id="@+id/homeNavBar"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="vertical"
                android:background="#F0F0FF">

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#C8C8E0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/homeNavHome"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="⌂"
                        android:textSize="16sp"
                        android:textColor="#2B3A8C"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/homeNavRotate"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="⟳"
                        android:textSize="16sp"
                        android:textColor="#2B3A8C"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════
             QUIZ SCREEN
        ══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/quizLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="4dp">

                <TextView
                    android:id="@+id/scoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/0"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/bg_score_badge" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/questionCard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="3"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:id="@+id/cardBorder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/question_card_border"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/questionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:textColor="#1A1A2E" />

                        <TextView
                            android:id="@+id/feedbackText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:visibility="gone" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/btnRow1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/option1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="2dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#2B3A8C"
                        app:cornerRadius="50dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/option2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#2B3A8C"
                        app:cornerRadius="50dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnRow2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/option3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="2dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#2B3A8C"
                        app:cornerRadius="50dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/option4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#2B3A8C"
                        app:cornerRadius="50dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Fixed nav bar -->
            <LinearLayout
                android:id="@+id/quizNavBar"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="vertical"
                android:background="#F0F0FF">

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#C8C8E0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/navHome"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="⌂"
                        android:textSize="16sp"
                        android:textColor="#2B3A8C"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/navRotate"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="⟳"
                        android:textSize="16sp"
                        android:textColor="#2B3A8C"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>
</FrameLayout>