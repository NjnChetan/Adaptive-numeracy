<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#BBBBCC"
    android:keepScreenOn="true"
    android:fitsSystemWindows="true">

    <!-- WHITE BAR — top of screen, respects status bar / camera cutout -->
    <View
        android:id="@+id/topWhiteBar"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="#FFFFFF" />

    <!-- TOP ROW: panels 1 & 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:clipChildren="true"
        android:clipToPadding="true">

        <FrameLayout
            android:id="@+id/clip1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true">
            <include
                android:id="@+id/panel1"
                layout="@layout/question_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#BBBBCC" />

        <FrameLayout
            android:id="@+id/clip2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true">
            <include
                android:id="@+id/panel2"
                layout="@layout/question_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

    </LinearLayout>

    <!-- Divider between rows -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#BBBBCC" />

    <!-- BOTTOM ROW: panels 3 & 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:clipChildren="true"
        android:clipToPadding="true">

        <FrameLayout
            android:id="@+id/clip3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true">
            <include
                android:id="@+id/panel3"
                layout="@layout/question_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#BBBBCC" />

        <FrameLayout
            android:id="@+id/clip4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true">
            <include
                android:id="@+id/panel4"
                layout="@layout/question_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

    </LinearLayout>

    <!-- WHITE BAR — bottom of screen, below panels 3 & 4 -->
    <View
        android:id="@+id/bottomWhiteBar"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="#FFFFFF" />

</LinearLayout>